<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" prefWidth="400.0" prefHeight="350.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="szoftver_fejlesztes_mozi.szoftver_fejlesztes_mozi.frontend.Alkalmazas.Controller.BejelentkezesController">
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
   <children>
      <Label text="Mozi Manager">
         <font>
            <Font name="System Bold" size="28.0" />
         </font>
      </Label>
      <TextField fx:id="felhasznaloMezo" promptText="Felhasználónév" />
      <PasswordField fx:id="jelszoMezo" promptText="Jelszó" onAction="#belepes" />
      <Button mnemonicParsing="false" onAction="#belepes" prefWidth="140.0" text="Belépés" />
      <Label fx:id="hibaCimke" textFill="RED" />
   </children>
</VBox>
